---
import Landing from '../layouts/Landing.astro'
import Nav from '../components/landing/Nav.astro'
import Hero from '../components/landing/Hero.astro'
import FeatureGrid from '../components/landing/FeatureGrid.astro'
import FeatureRow from '../components/landing/FeatureRow.astro'
import TrustStrip from '../components/landing/TrustStrip.astro'
import GetStarted from '../components/landing/GetStarted.astro'
import Footer from '../components/landing/Footer.astro'
---
<Landing title="ParishCRM — free, self-hosted church management" description="Families, accounting, event ticketing, petty cash and receipts in one open-source app your church runs itself.">
  <Nav />
  <main>
    <Hero />
    <FeatureGrid />
    <FeatureRow eyebrow="Accounting" title="Books your treasurer will trust"
      points={['Income and expenses against your own chart of accounts and funds', 'Budgets, P&L and reconciliation reports', 'Read-only auditor access with CSV export']}
      shot="accounting" alt="Accounting transactions list with category and fund columns" href="docs/accounting-overview/" />
    <FeatureRow flip eyebrow="Events" title="From sign-up page to door check-in"
      points={['Public registration pages, optional card payments', 'Organisers manage only their own events', 'Automatic reminder emails before the day']}
      shot="events" alt="Event registrations list with payment status" href="docs/events-overview/" />
    <FeatureRow eyebrow="Members" title="Every family, one record"
      points={['Households with members, roles and classifications', 'Birthday and anniversary reminders', 'Families can update their own details by secure link']}
      shot="families" alt="Family record showing household members" href="docs/people-and-families/" />
    <TrustStrip />
    <GetStarted />
  </main>
  <Footer />
</Landing>
