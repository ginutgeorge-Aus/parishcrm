{
  "name": "parishcrm",
  "version": "1.0.0",
  "description": "Single-tenant, self-hosted church CRM — people, families, accounting, events, and membership.",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parishcrm/parishcrm.git"
  },
  "homepage": "https://github.com/parishcrm/parishcrm#readme",
  "bugs": {
    "url": "https://github.com/parishcrm/parishcrm/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "knip": "knip",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "license:check": "node scripts/check-licenses.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
