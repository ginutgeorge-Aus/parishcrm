# ParishCRM configuration reference — every environment variable the app reads.
#
# Production: copy to `.env` (see docs/self-hosting.md). Local dev: copy to
# `.env.local` (see README → Getting started). Values here are placeholders.
# Church identity, branding, letters, receipts and accounts are edited in-app
# (Settings), not here. Missing or invalid required values fail the boot with
# a clear error (src/lib/envCheck.ts).

# ── Required ────────────────────────────────────────────────────────────────
# (No trailing comments after any value, active or commented: `docker
# --env-file` keeps them as part of the value once a line is uncommented.)
# Postgres connection; add ?sslmode=require for a remote DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/parishcrm"
# Signs sessions + sign-in codes. Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Public https:// URL in production — must match, or sign-in redirects break.
AUTH_URL="http://localhost:3000"
# Field encryption. Generate: openssl rand -base64 32. Back it up separately —
# losing it makes encrypted member data unrecoverable.
ENCRYPTION_KEY="<base64 32-byte key>"

# Sign-in codes (OTP), receipts and notifications are sent through Gmail SMTP
# with an app password. Boot requires them unless DISABLE_OTP is set (local dev
# only), but every other email feature still needs them.
GMAIL_USER="church@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx"

# ── Church identity (fallbacks) ─────────────────────────────────────────────
# Used until an ADMIN fills Settings → Church Information, which takes precedence.
CHURCH_NAME="Your Church"
CHURCH_ADDRESS="123 Example St, Example Town"
# Tax / charity registration number (region-specific).
CHURCH_ABN="12 345 678 901"
CHURCH_WEBSITE="https://example.org"

# ── Regional (runtime; defaults = Australia) ───────────────────────────────
# Fiscal-year start month, 1-12 (7 = July):
# APP_FY_START_MONTH="7"
# IANA timezone:
# APP_TIMEZONE="Australia/Sydney"
# BCP-47 locale for money/date formatting:
# APP_LOCALE="en-AU"
# ISO-4217 currency code (also the Stripe checkout currency):
# APP_CURRENCY="AUD"

# ── Theme (optional) ────────────────────────────────────────────────────────
# Hex #RRGGBB. Unset = neutral slate. Applies to UI, PDFs, emails, print, and
# the mobile status bar. THEME_PRIMARY_DARK falls back to THEME_PRIMARY.
# THEME_PRIMARY="#1e293b"
# THEME_PRIMARY_DARK="#1e3a5f"
# THEME_ACCENT="#c8a24a"

# ── Scheduled jobs (optional) ───────────────────────────────────────────────
# Bearer secret for POST /api/cron/{send-reminders,sweep-checkouts,
# send-celebrations,error-issues}. Unset = those endpoints refuse every call
# (reminders, celebration emails and the abandoned-checkout PII sweep stop).
# CRON_SECRET="generate-with-openssl-rand-base64-32"

# ── Online card payments for event tickets (optional) ───────────────────────
# OFF unless BOTH set; otherwise registrations use bank transfer (PENDING).
# Register a Stripe webhook at <AUTH_URL>/api/stripe/webhook.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── CAPTCHA on public forms (optional) ─────────────────────────────────────
# Cloudflare Turnstile. Set BOTH or neither: the server demands a token
# whenever the secret is set, and the widget only renders with the site key.
# (NEXT_PUBLIC_TURNSTILE_SITE_KEY is still accepted as a deprecated alias.)
# TURNSTILE_SECRET_KEY="<cf secret>"
# TURNSTILE_SITE_KEY="<cf site key>"

# ── Membership applications (optional) ──────────────────────────────────────
# Where public /membershipform alerts go. Precedence: Settings → App Settings,
# then this, then GMAIL_USER.
# MEMBERSHIP_SECRETARY_EMAIL="office@example.org"

# ── Event webhook to an external website (optional) ─────────────────────────
# HMAC-signed push on event create/update/delete. Contract: docs/event-webhook.md.
# Leave unset in local dev (it would post test events to the live site).
# WEBSITE_SYNC_URL="https://example.org/api/crm-sync"
# WEBSITE_SYNC_SECRET="<base64 32-byte key>"

# ── In-app bug reports → GitHub issues (optional) ───────────────────────────
# Fine-grained PAT with Issues: write on GITHUB_REPO. Unset = widget disabled.
# GITHUB_TOKEN="github_pat_..."
# GITHUB_REPO="your-org/your-repo"

# ── Observability (optional) ────────────────────────────────────────────────
# Application Insights (OpenTelemetry) connection string. Unset = no telemetry.
# APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=..."

# ── Encryption key rotation ─────────────────────────────────────────────────
# ENCRYPTION_KEY alone acts as key v1. To rotate, in this order:
#   1. promote it: ENCRYPTION_KEY_V1=<same value as ENCRYPTION_KEY>
#      (the boot refuses a non-v1 ENCRYPTION_KEY_ID while v1 exists only as
#      the ENCRYPTION_KEY alias)
#   2. add ENCRYPTION_KEY_V2=<new key> and set ENCRYPTION_KEY_ID=v2
#   3. run `npx tsx scripts/rotate-encryption-key.ts --apply --yes`
# KEEP the v1 key permanently: the email/mobile lookup hashes are derived from
# it, and it decrypts any value not yet rotated. Losing it is unrecoverable.
# ENCRYPTION_KEY_V1="<base64 32-byte key>"
# ENCRYPTION_KEY_V2="<base64 32-byte key>"
# ENCRYPTION_KEY_ID=v1

# ── Migrations ──────────────────────────────────────────────────────────────
# Direct (non-pooled) connection for `prisma migrate`, if DATABASE_URL goes
# through a pooler. Defaults to DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/parishcrm"

# ── Legacy aliases ──────────────────────────────────────────────────────────
# NEXTAUTH_SECRET / NEXTAUTH_URL are read as fallbacks for AUTH_SECRET /
# AUTH_URL. If both secrets are set they must be identical, or the boot fails.
# APP_URL is a fallback base URL for Stripe redirects — unused once AUTH_URL
# is set (it is required). Schedulers use it as the base for cron calls.

# ── Set by the platform / build — do not set by hand ────────────────────────
# CONTAINER_APP_REPLICA_COUNT  replica count; >1 logs a warning (the rate
#                              limiter is in-memory — run a single replica)
# NEXT_PUBLIC_APP_VERSION /    version + commit shown in Settings; baked at
# NEXT_PUBLIC_GIT_SHA          image build from Docker ARGs APP_VERSION / GIT_SHA

# ── Local development only — NEVER in production ────────────────────────────
# Skip the emailed sign-in code (the boot refuses it in production):
# DISABLE_OTP=true
# Let `npm run db:seed` create demo users (their passwords are public in this repo):
# ALLOW_DEMO_SEED=true
# JSONL query log for perf work (both or neither):
# PERF_QUERY_LOG="1"
# PERF_QUERY_LOG_FILE="/tmp/queries.jsonl"
